<Project Sdk="Microsoft.NET.Sdk">

  <!-- Cliente de sala sobre el proceso dathinel-red (docs/api.md §5). -->
  <PropertyGroup>
    <RootNamespace>Dathinel.Sala</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Como Rodaje.Modules.Protocol: el mismo RID con y sin «-r win-x64», para que el lockfile no gane o pierda «net10.0/win-x64»
         según quién lo restaure (Rodaje lo restaura con y sin RID en su CI: NU1004 en modo bloqueado). -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <!-- Identidad.cs llama a DPAPI con LibraryImport, cuyo código generado necesita unsafe. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rodaje.Modules.Protocol\Rodaje.Modules.Protocol.csproj" />
    <InternalsVisibleTo Include="Dathinel.Sala.Tests" />
    <EmbeddedResource Include="palabras.txt" LogicalName="Dathinel.Sala.palabras.txt" />
  </ItemGroup>

</Project>
