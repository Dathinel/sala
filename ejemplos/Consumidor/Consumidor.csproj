<Project Sdk="Microsoft.NET.Sdk">

  <!-- Consumidor mínimo de la sala, publicado con Native AOT en la CI para comprobar el recorte. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CA1031;CA2007</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Dathinel.Sala\Dathinel.Sala.csproj" />
  </ItemGroup>

</Project>
